# Snakefile — ESKAPE defence ML pipeline (4× scaling study)
#
# Adapted from: eskape-defence-ml/workflow/Snakefile
# Changes from original:
#   - All DB paths repointed to original project (read-only, no DB setup rules)
#   - DB setup rules removed: checkm2_db, defensefinder_models,
#     padloc_db_update, amrfinderplus_db — all DBs exist in original project
#   - Species config: 3,460 genomes (config/species.yaml in this project)
#
# Usage (run from eskape-defence-ml_2/):
#   conda activate eskape-ml
#   snakemake -n --use-conda \
#     --conda-prefix /Users/Vicky/Acinetobacter_ML_2/eskape-defence-ml/.snakemake/conda/ \
#     --rerun-triggers mtime
#
#   snakemake --cores 8 --use-conda \
#     --conda-prefix /Users/Vicky/Acinetobacter_ML_2/eskape-defence-ml/.snakemake/conda/ \
#     --rerun-incomplete --rerun-triggers mtime

import yaml
import os

configfile: "config/params.yaml"

# ── Original project root (read-only — databases live here) ──────────────────
ORIG = "/Users/Vicky/Acinetobacter_ML_2/eskape-defence-ml"

# ── Load species and accessions from config ───────────────────────────────────
with open("config/species.yaml") as f:
    SPECIES_CFG = yaml.safe_load(f)

SPECIES    = list(SPECIES_CFG["species"].keys())

# Load accessions excluded due to leakage (published paper genomes accidentally downloaded)
_excluded_path = "config/excluded_accessions.yaml"
EXCLUDED = {}
if os.path.exists(_excluded_path):
    with open(_excluded_path) as _f:
        _excl = yaml.safe_load(_f) or {}
    EXCLUDED = {sp: set(accs) for sp, accs in _excl.items()}

ACCESSIONS = {
    sp: [a for a in cfg["accessions"] if a not in EXCLUDED.get(sp, set())]
    for sp, cfg in SPECIES_CFG["species"].items()
}

# Flat list of (species, accession) pairs — used for per-genome rules
SP_ACC = [
    (sp, acc)
    for sp, accs in ACCESSIONS.items()
    for acc in accs
]

# ── Helper: accession → safe filename (replace . with _) ──────────────────────
def acc_to_fname(acc: str) -> str:
    return acc.replace(".", "_")


# ── Reference databases (read-only: all in original project) ──────────────────
BACMET_DB    = f"{ORIG}/data/raw/databases/BacMet2_EXP_database.fasta"
ICEBERG_DB   = f"{ORIG}/data/raw/databases/ICEberg_IME.fasta"
RESFINDER_DB = f"{ORIG}/data/raw/databases/db_resfinder"

CHECKM2_DB         = f"{ORIG}/data/raw/databases/checkm2/CheckM2_database/uniref100.KO.1.dmnd"
DEFENSEFINDER_FLAG = f"{ORIG}/data/raw/databases/defensefinder_models_ready.flag"
DEFENSEFINDER_DIR  = f"{ORIG}/data/raw/databases/defensefinder_models"
PADLOC_FLAG        = f"{ORIG}/data/raw/databases/padloc_db_ready.flag"
AMRFINDER_FLAG     = f"{ORIG}/data/raw/databases/amrfinderplus_ready.flag"

# ── AMRFinderPlus: species → organism lookup ──────────────────────────────────
AMRFINDER_ORGANISM = {
    "abaumannii":  "Acinetobacter_baumannii",
    "ecloaceae":   "Enterobacter_cloacae",
    "efaecium":    "Enterococcus_faecium",
    "kpneumoniae": "Klebsiella_pneumoniae",
    "paeruginosa": "Pseudomonas_aeruginosa",
    "saureus":     "Staphylococcus_aureus",
}


# ── Rule all: final targets ───────────────────────────────────────────────────
rule all:
    input:
        # QC reports per species
        expand("data/interim/{sp}/qc/checkm2_quality_report.tsv", sp=SPECIES),
        # Annotation outputs per genome
        expand(
            "data/interim/{sp}/defensefinder/{acc_fn}/defense_finder_systems.tsv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand(
            "data/interim/{sp}/padloc/{acc_fn}_padloc.csv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand(
            "data/interim/{sp}/resfinder/{acc_fn}/ResFinder_results_tab.txt",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand(
            "data/interim/{sp}/iceberg/{acc_fn}_iceberg.tsv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand(
            "data/interim/{sp}/isescan/{acc_fn}_isescan.tsv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand("data/interim/{sp}/bacmet/{acc_fn}_bacmet.tsv", zip,
               sp=[s for s, a in SP_ACC],
               acc_fn=[acc_to_fname(a) for s, a in SP_ACC]),
        expand("data/interim/{sp}/mlst/mlst_results.tsv", sp=SPECIES),
        # Consolidated per-species metadata tables
        expand("data/interim/{sp}/metadata.tsv", sp=SPECIES),
        # AMRFinderPlus metal resistance (hmrg source)
        expand(
            "data/interim/{sp}/amrfinderplus/{acc_fn}_amrfinder.tsv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),


# ── 1. Download genomes ───────────────────────────────────────────────────────
rule download_genome:
    output:
        fasta = "data/raw/genomes/{sp}/{acc_fn}.fna",
    params:
        acc = lambda wc: wc.acc_fn.rsplit("_", 1)[0] + "." + wc.acc_fn.rsplit("_", 1)[1],
        outdir_prefix = "data/raw/genomes/{sp}/tmp_{acc_fn}",
    conda: "envs/blast.yaml"
    retries: 3
    shell:
        """
        mkdir -p "$(dirname {output.fasta})"
        tmpdir="$(mktemp -d {params.outdir_prefix}.XXXXXX)"
        trap 'rm -rf "$tmpdir"' EXIT

        download_and_extract() {{
            local acc="$1"
            local archive="$2"
            local attempt

            for attempt in 1 2 3 4 5; do
                rm -f "$archive"
                rm -rf "$tmpdir/ncbi_dataset"

                if datasets download genome accession "$acc" \
                    --include genome \
                    --filename "$archive"; then
                    if unzip -tq "$archive" >/dev/null 2>&1; then
                        unzip -oq "$archive" -d "$tmpdir/"
                        return 0
                    fi
                    echo "Corrupt genome archive for $acc (attempt $attempt/5), retrying." >&2
                else
                    echo "datasets download failed for $acc (attempt $attempt/5), retrying." >&2
                fi

                sleep $((attempt * 5))
            done

            return 1
        }}

        if ! download_and_extract "{params.acc}" "$tmpdir/genome.zip"; then
            echo "Failed to download a valid genome archive for {params.acc}." >&2
            exit 1
        fi

        genome_fna="$(find "$tmpdir" -name "*.fna" -print -quit)"
        if [ -z "$genome_fna" ]; then
            paired_acc="$(python - "$tmpdir" <<'PY'
import json
from pathlib import Path
import sys

report_path = Path(sys.argv[1]) / "ncbi_dataset" / "data" / "assembly_data_report.jsonl"
if not report_path.exists():
    print("")
    raise SystemExit

with report_path.open() as handle:
    report = json.loads(next(handle))

assembly_info = report.get("assemblyInfo", {{}})
paired_assembly = assembly_info.get("pairedAssembly", {{}}) or {{}}
print(paired_assembly.get("accession") or report.get("pairedAccession") or "")
PY
)"

            if [ -n "$paired_acc" ]; then
                if ! download_and_extract "$paired_acc" "$tmpdir/paired_genome.zip"; then
                    echo "Failed to download a valid paired genome archive for $paired_acc." >&2
                    exit 1
                fi
                genome_fna="$(find "$tmpdir" -name "*.fna" -print -quit)"
            fi
        fi

        if [ -z "$genome_fna" ]; then
            echo "No genomic FASTA found for {params.acc} (or paired accession fallback)." >&2
            exit 1
        fi

        mv "$genome_fna" {output.fasta}
        """


# ── 2. CheckM2 QC (per species, runs on all genomes at once) ─────────────────
# DB is read from the original project (read-only). checkm2_db rule removed.
rule checkm2:
    input:
        fastas = lambda wc: expand(
            "data/raw/genomes/{sp}/{acc_fn}.fna",
            sp=wc.sp,
            acc_fn=[acc_to_fname(a) for a in ACCESSIONS[wc.sp]],
        ),
        db = CHECKM2_DB,
    output:
        report = "data/interim/{sp}/qc/checkm2_quality_report.tsv",
    params:
        genome_dir = "data/raw/genomes/{sp}",
        out_dir    = "data/interim/{sp}/qc",
        min_completeness = config["qc"]["checkm2_completeness_min"],
        max_contamination = config["qc"]["checkm2_contamination_max"],
    threads: 8
    conda:
        "/Users/Vicky/crc/.conda_envs/checkm2"
    shell:
        """
        python - <<'PY'
import multiprocessing as mp
import sys

mp.set_start_method("fork", force=True)

from checkm2.main import main

sys.argv = [
    "checkm2",
    "predict",
    "--input", "{params.genome_dir}",
    "--output-directory", "{params.out_dir}",
    "--database_path", "{input.db}",
    "--threads", "{threads}",
    "--force",
]
sys.exit(main())
PY
        mv -f {params.out_dir}/quality_report.tsv {output.report}
        """


# ── 3. DefenseFinder (+ AntiDefenseFinder via --antidefensefinder) ────────────
# Models dir and flag are read from the original project. defensefinder_models
# rule removed.
rule defensefinder:
    input:
        fasta       = "data/raw/genomes/{sp}/{acc_fn}.fna",
        models_flag = DEFENSEFINDER_FLAG,
    output:
        systems  = "data/interim/{sp}/defensefinder/{acc_fn}/defense_finder_systems.tsv",
        genes    = "data/interim/{sp}/defensefinder/{acc_fn}/defense_finder_genes.tsv",
        proteins = "data/interim/{sp}/defensefinder/{acc_fn}/{acc_fn}.prt",
    params:
        outdir     = "data/interim/{sp}/defensefinder/{acc_fn}",
        models_dir = DEFENSEFINDER_DIR,
    conda: "envs/defensefinder.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        python - <<'PY'
from pyhmmer.easel import Alphabet, SequenceFile, TextSequence
import pyrodigal

input_fasta = "{input.fasta}"
protein_fasta = "{output.proteins}"

with SequenceFile(input_fasta) as sf, open(protein_fasta, "w") as protein_out:
    seq = TextSequence()
    if sf.guess_alphabet() != Alphabet.dna():
        raise ValueError(f"Expected nucleotide FASTA for DefenseFinder preprocessing: {{input_fasta}}")

    while sf.readinto(seq) is not None:
        sseq = bytes(seq.sequence, encoding="utf-8")
        sname = seq.name.decode() if isinstance(seq.name, (bytes, bytearray)) else str(seq.name)
        if len(sseq) < 100000:
            gene_finder = pyrodigal.GeneFinder(meta=True)
            genes = gene_finder.find_genes(sseq)
        else:
            gene_finder = pyrodigal.GeneFinder()
            gene_finder.train(sseq)
            genes = gene_finder.find_genes(sseq)
        genes.write_translations(protein_out, sname)
        seq.clear()
PY
        defense-finder run \
            --models-dir {params.models_dir} \
            --antidefensefinder \
            --out-dir {params.outdir} \
            {output.proteins}
        mv -f {params.outdir}/{wildcards.acc_fn}_defense_finder_systems.tsv {output.systems} 2>/dev/null \
            || touch {output.systems}
        mv -f {params.outdir}/{wildcards.acc_fn}_defense_finder_genes.tsv {output.genes} 2>/dev/null \
            || touch {output.genes}
        """


# ── 4. PADLOC annotation ──────────────────────────────────────────────────────
# DB flag read from original project. padloc_db_update rule removed.
rule padloc:
    input:
        fasta   = "data/raw/genomes/{sp}/{acc_fn}.fna",
        db_flag = PADLOC_FLAG,
    output:
        csv = "data/interim/{sp}/padloc/{acc_fn}_padloc.csv",
    params:
        outdir = "data/interim/{sp}/padloc",
    conda: "envs/padloc.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        padloc --fna {input.fasta} \
               --outdir {params.outdir} \
               --cpu 2
        [ -f {output.csv} ] || touch {output.csv}
        """


# ── 5. ResFinder (ARG detection) ──────────────────────────────────────────────
rule resfinder:
    input:
        fasta = "data/raw/genomes/{sp}/{acc_fn}.fna",
    output:
        tab = "data/interim/{sp}/resfinder/{acc_fn}/ResFinder_results_tab.txt",
    params:
        outdir   = "data/interim/{sp}/resfinder/{acc_fn}",
        db_path  = RESFINDER_DB,
    conda:
        "/opt/homebrew/Caskroom/miniconda/base/envs/resfinder_env"
    shell:
        """
        mkdir -p {params.outdir}
        python -m resfinder \
            -ifa {input.fasta} \
            -o {params.outdir} \
            -db_res {params.db_path} \
            -s "Other" \
            --acquired \
            -l 0.6 \
            -t 0.9
        [ -f {output.tab} ] || touch {output.tab}
        """


# ── 6. ISEScan — insertion sequence detection ─────────────────────────────────
rule isescan:
    input:
        fasta = "data/raw/genomes/{sp}/{acc_fn}.fna",
    output:
        tsv = "data/interim/{sp}/isescan/{acc_fn}_isescan.tsv",
        sum = "data/interim/{sp}/isescan/{acc_fn}_isescan.sum",
    params:
        run_dir = "data/interim/{sp}/isescan/{acc_fn}_run",
    threads: 2
    conda: "envs/isescan.yaml"
    shell:
        """
        mkdir -p {params.run_dir}
        cp {input.fasta} {params.run_dir}/{wildcards.acc_fn}.fna
        (cd {params.run_dir} && isescan.py \
            --seqfile {wildcards.acc_fn}.fna \
            --output . \
            --nthread {threads})
        mv -f {params.run_dir}/{wildcards.acc_fn}.fna.tsv {output.tsv} 2>/dev/null \
            || touch {output.tsv}
        mv -f {params.run_dir}/{wildcards.acc_fn}.fna.sum {output.sum} 2>/dev/null \
            || touch {output.sum}
        rm -rf {params.run_dir}
        """


# ── 7. ICEberg IME tBLASTn ────────────────────────────────────────────────────
rule iceberg_tblastn:
    input:
        fasta  = "data/raw/genomes/{sp}/{acc_fn}.fna",
        db     = ICEBERG_DB,
    output:
        tsv = "data/interim/{sp}/iceberg/{acc_fn}_iceberg.tsv",
    params:
        evalue = 1e-5,
    conda: "envs/blast.yaml"
    shell:
        """
        mkdir -p data/interim/{wildcards.sp}/iceberg
        tblastn \
            -query {input.db} \
            -subject {input.fasta} \
            -evalue {params.evalue} \
            -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore" \
            -out {output.tsv} 2>/dev/null || true
        [ -f {output.tsv} ] || touch {output.tsv}
        """


# ── 8. BacMet HMRG tBLASTn ───────────────────────────────────────────────────
rule bacmet_tblastn:
