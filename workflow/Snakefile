# Snakefile — ESKAPE defence ML pipeline
# Phase 2: genome download, QC, and annotation
#
# Extends: github.com/vikos77/acinetobacter-defence-pipeline
# All tool versions pinned in workflow/envs/*.yaml
#
# Usage:
#   conda activate eskape-ml
#   snakemake --use-conda --cores 8 --rerun-incomplete
#
# For a dry-run (see what would run without running it):
#   snakemake --use-conda --cores 8 -n

import yaml
import os

configfile: "config/params.yaml"

# ── Load species and accessions from config ───────────────────────────────────
with open("config/species.yaml") as f:
    SPECIES_CFG = yaml.safe_load(f)

SPECIES   = list(SPECIES_CFG["species"].keys())
ACCESSIONS = {
    sp: cfg["accessions"]
    for sp, cfg in SPECIES_CFG["species"].items()
}

# Flat list of (species, accession) pairs — used for per-genome rules
SP_ACC = [
    (sp, acc)
    for sp, accs in ACCESSIONS.items()
    for acc in accs
]

# ── Helper: accession → safe filename (replace . with _) ──────────────────────
def acc_to_fname(acc: str) -> str:
    return acc.replace(".", "_")


# ── Reference databases (run workflow/scripts/setup_databases.sh first) ───────
BACMET_DB   = "data/raw/databases/BacMet2_EXP_database.fasta"
ICEBERG_DB  = "data/raw/databases/ICEberg_IME.fasta"
RESFINDER_DB = "data/raw/databases/db_resfinder"

# ── AMRFinderPlus: database flag + species → organism lookup ──────────────────
# amrfinder -u only writes to the default location within its conda env.
# The flag file records that the download completed; subsequent runs reuse it.
AMRFINDER_FLAG = "data/raw/databases/amrfinderplus_ready.flag"

AMRFINDER_ORGANISM = {
    "abaumannii":  "Acinetobacter_baumannii",
    "ecloaceae":   "Enterobacter_cloacae",
    "efaecium":    "Enterococcus_faecium",
    "kpneumoniae": "Klebsiella_pneumoniae",
    "paeruginosa": "Pseudomonas_aeruginosa",
    "saureus":     "Staphylococcus_aureus",
}


# ── Rule all: final targets ───────────────────────────────────────────────────
rule all:
    input:
        # QC reports per species
        expand("data/interim/{sp}/qc/checkm2_quality_report.tsv", sp=SPECIES),
        # Annotation outputs per genome
        expand(
            "data/interim/{sp}/defensefinder/{acc_fn}/defense_finder_systems.tsv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand(
            "data/interim/{sp}/padloc/{acc_fn}_padloc.csv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand(
            "data/interim/{sp}/resfinder/{acc_fn}/ResFinder_results_tab.txt",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand(
            "data/interim/{sp}/iceberg/{acc_fn}_iceberg.tsv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand(
            "data/interim/{sp}/isescan/{acc_fn}_isescan.tsv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),
        expand("data/interim/{sp}/bacmet/{acc_fn}_bacmet.tsv", zip,
               sp=[s for s, a in SP_ACC],
               acc_fn=[acc_to_fname(a) for s, a in SP_ACC]),
        expand("data/interim/{sp}/mlst/mlst_results.tsv", sp=SPECIES),
        # Consolidated per-species metadata tables
        expand("data/interim/{sp}/metadata.tsv", sp=SPECIES),
        # AMRFinderPlus metal resistance (replaces BacMet — cross-species safe)
        expand(
            "data/interim/{sp}/amrfinderplus/{acc_fn}_amrfinder.tsv",
            zip,
            sp=[s for s, a in SP_ACC],
            acc_fn=[acc_to_fname(a) for s, a in SP_ACC],
        ),


# ── 1. Download genomes ───────────────────────────────────────────────────────
# Downloads the FASTA for one accession using ncbi-datasets-cli.
# Output flagged with a sentinel file so re-download is not triggered if the
# FASTA already exists.

rule download_genome:
    output:
        fasta = "data/raw/genomes/{sp}/{acc_fn}.fna",
    params:
        # GCF_043738335_1 → GCF_043738335.1 (only the last underscore becomes a dot)
        acc = lambda wc: wc.acc_fn.rsplit("_", 1)[0] + "." + wc.acc_fn.rsplit("_", 1)[1],
        outdir_prefix = "data/raw/genomes/{sp}/tmp_{acc_fn}",
    conda: "envs/blast.yaml"
    retries: 3
    shell:
        """
        mkdir -p "$(dirname {output.fasta})"
        tmpdir="$(mktemp -d {params.outdir_prefix}.XXXXXX)"
        trap 'rm -rf "$tmpdir"' EXIT

        download_and_extract() {{
            local acc="$1"
            local archive="$2"
            local attempt

            for attempt in 1 2 3 4 5; do
                rm -f "$archive"
                rm -rf "$tmpdir/ncbi_dataset"

                if datasets download genome accession "$acc" \
                    --include genome \
                    --filename "$archive"; then
                    if unzip -tq "$archive" >/dev/null 2>&1; then
                        unzip -oq "$archive" -d "$tmpdir/"
                        return 0
                    fi
                    echo "Corrupt genome archive for $acc (attempt $attempt/5), retrying." >&2
                else
                    echo "datasets download failed for $acc (attempt $attempt/5), retrying." >&2
                fi

                sleep $((attempt * 5))
            done

            return 1
        }}

        if ! download_and_extract "{params.acc}" "$tmpdir/genome.zip"; then
            echo "Failed to download a valid genome archive for {params.acc}." >&2
            exit 1
        fi

        genome_fna="$(find "$tmpdir" -name "*.fna" -print -quit)"
        if [ -z "$genome_fna" ]; then
            paired_acc="$(python - "$tmpdir" <<'PY'
import json
from pathlib import Path
import sys

report_path = Path(sys.argv[1]) / "ncbi_dataset" / "data" / "assembly_data_report.jsonl"
if not report_path.exists():
    print("")
    raise SystemExit

with report_path.open() as handle:
    report = json.loads(next(handle))

assembly_info = report.get("assemblyInfo", {{}})
paired_assembly = assembly_info.get("pairedAssembly", {{}}) or {{}}
print(paired_assembly.get("accession") or report.get("pairedAccession") or "")
PY
)"

            if [ -n "$paired_acc" ]; then
                if ! download_and_extract "$paired_acc" "$tmpdir/paired_genome.zip"; then
                    echo "Failed to download a valid paired genome archive for $paired_acc." >&2
                    exit 1
                fi
                genome_fna="$(find "$tmpdir" -name "*.fna" -print -quit)"
            fi
        fi

        if [ -z "$genome_fna" ]; then
            echo "No genomic FASTA found for {params.acc} (or paired accession fallback)." >&2
            exit 1
        fi

        mv "$genome_fna" {output.fasta}
        """


# ── 2a. CheckM2 database setup (runs once) ────────────────────────────────────
rule checkm2_db:
    output:
        db = "data/raw/databases/checkm2/CheckM2_database/uniref100.KO.1.dmnd",
    params:
        db_dir = "data/raw/databases/checkm2",
        archive = "data/raw/databases/checkm2/checkm2_database.tar.gz",
        url = "https://zenodo.org/api/records/14897628/files/checkm2_database.tar.gz/content",
        md5 = "07c10655620843b517d0df0c160d911f",
    conda:
        "/Users/Vicky/crc/.conda_envs/checkm2"
    shell:
        """
        mkdir -p {params.db_dir}
        for attempt in 1 2 3 4 5 6 7 8; do
            curl_status=0
            curl -fL -C - --retry 5 --retry-delay 10 --retry-all-errors \
                {params.url} \
                -o {params.archive} || curl_status=$?

            actual_md5="$(python - {params.archive} <<'PY'
import hashlib
import sys
from pathlib import Path

archive = Path(sys.argv[1])
if not archive.exists():
    print("")
    raise SystemExit

digest = hashlib.md5()
with archive.open("rb") as handle:
    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
        digest.update(chunk)
print(digest.hexdigest())
PY
)"

            if [ "$actual_md5" = "{params.md5}" ]; then
                break
            fi

            echo "CheckM2 database checksum mismatch or incomplete download on attempt $attempt/8." >&2
            if [ "$curl_status" -eq 0 ]; then
                rm -f {params.archive}
            fi
            sleep $((attempt * 30))
        done

        if [ "$actual_md5" != "{params.md5}" ]; then
            echo "Failed to download a valid CheckM2 database archive." >&2
            exit 1
        fi

        rm -rf {params.db_dir}/CheckM2_database
        tar -xzf {params.archive} -C {params.db_dir}
        test -f {output.db}
        """


# ── 2b. CheckM2 QC (per species, runs on all genomes at once) ─────────────────
# CheckM2 is more accurate than CheckM1 and does not require a reference tree.
# We run it per-species in batch mode rather than per-genome for speed.

rule checkm2:
    input:
        fastas = lambda wc: expand(
            "data/raw/genomes/{sp}/{acc_fn}.fna",
            sp=wc.sp,
            acc_fn=[acc_to_fname(a) for a in ACCESSIONS[wc.sp]],
        ),
        db = "data/raw/databases/checkm2/CheckM2_database/uniref100.KO.1.dmnd",
    output:
        report = "data/interim/{sp}/qc/checkm2_quality_report.tsv",
    params:
        genome_dir = "data/raw/genomes/{sp}",
        out_dir    = "data/interim/{sp}/qc",
        min_completeness = config["qc"]["checkm2_completeness_min"],
        max_contamination = config["qc"]["checkm2_contamination_max"],
    threads: 8
    conda:
        "/Users/Vicky/crc/.conda_envs/checkm2"
    shell:
        """
        python - <<'PY'
import multiprocessing as mp
import sys

# macOS defaults to spawn, which breaks CheckM2 1.1.0 private multiprocessing
# targets. Fork mode matches the Linux behavior CheckM2 expects.
mp.set_start_method("fork", force=True)

from checkm2.main import main

sys.argv = [
    "checkm2",
    "predict",
    "--input", "{params.genome_dir}",
    "--output-directory", "{params.out_dir}",
    "--database_path", "{input.db}",
    "--threads", "{threads}",
    "--force",
]
sys.exit(main())
PY
        mv -f {params.out_dir}/quality_report.tsv {output.report}
        """


# ── 3a. DefenseFinder models (runs once) ──────────────────────────────────────
# defense-finder 2.0.1 currently installs CasFinder 3.1.1, whose XML grammar
# (vers=2.1) is rejected by the bundled macsyfinder 2.1.4 parser. We replace it
# with the last 2.0-compatible release.
rule defensefinder_models:
    output:
        flag = "data/raw/databases/defensefinder_models_ready.flag",
    params:
        models_dir = "data/raw/databases/defensefinder_models",
        casfinder_url = "https://github.com/macsy-models/CasFinder/archive/refs/tags/3.1.0.tar.gz",
    conda: "envs/defensefinder.yaml"
    shell:
        """
        rm -rf {params.models_dir}
        mkdir -p {params.models_dir}
        defense-finder update --models-dir {params.models_dir}
        rm -rf {params.models_dir}/CasFinder
        curl -fL {params.casfinder_url} -o {params.models_dir}/CasFinder-3.1.0.tar.gz
        tar -xzf {params.models_dir}/CasFinder-3.1.0.tar.gz -C {params.models_dir}
        mv {params.models_dir}/CasFinder-3.1.0 {params.models_dir}/CasFinder
        rm -f {params.models_dir}/CasFinder-3.1.0.tar.gz
        touch {output.flag}
        """


# ── 3b. DefenseFinder (+ AntiDefenseFinder via --antidefensefinder flag) ─────
# defense-finder 2.0.1 crashes on nucleotide FASTA input in the pyhmmer parsing
# path. We precompute proteins with the same pyrodigal logic defense-finder uses,
# then run on the protein FASTA against a workflow-owned, version-compatible
# model bundle.
rule defensefinder:
    input:
        fasta = "data/raw/genomes/{sp}/{acc_fn}.fna",
        models_flag = "data/raw/databases/defensefinder_models_ready.flag",
    output:
        systems = "data/interim/{sp}/defensefinder/{acc_fn}/defense_finder_systems.tsv",
        genes   = "data/interim/{sp}/defensefinder/{acc_fn}/defense_finder_genes.tsv",
    params:
        outdir = "data/interim/{sp}/defensefinder/{acc_fn}",
        proteins = "data/interim/{sp}/defensefinder/{acc_fn}/{acc_fn}.prt",
        models_dir = "data/raw/databases/defensefinder_models",
    conda: "envs/defensefinder.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        python - <<'PY'
from pyhmmer.easel import Alphabet, SequenceFile, TextSequence
import pyrodigal

input_fasta = "{input.fasta}"
protein_fasta = "{params.proteins}"

with SequenceFile(input_fasta) as sf, open(protein_fasta, "w") as protein_out:
    seq = TextSequence()
    if sf.guess_alphabet() != Alphabet.dna():
        raise ValueError(f"Expected nucleotide FASTA for DefenseFinder preprocessing: {{input_fasta}}")

    while sf.readinto(seq) is not None:
        sseq = bytes(seq.sequence, encoding="utf-8")
        sname = seq.name.decode() if isinstance(seq.name, (bytes, bytearray)) else str(seq.name)
        if len(sseq) < 100000:
            gene_finder = pyrodigal.GeneFinder(meta=True)
            genes = gene_finder.find_genes(sseq)
        else:
            gene_finder = pyrodigal.GeneFinder()
            gene_finder.train(sseq)
            genes = gene_finder.find_genes(sseq)
        genes.write_translations(protein_out, sname)
        seq.clear()
PY
        defense-finder run \
            --models-dir {params.models_dir} \
            --antidefensefinder \
            --out-dir {params.outdir} \
            {params.proteins}
        # defense-finder prefixes outputs with genome name — rename to fixed names
        mv -f {params.outdir}/{wildcards.acc_fn}_defense_finder_systems.tsv {output.systems} 2>/dev/null \
            || touch {output.systems}
        mv -f {params.outdir}/{wildcards.acc_fn}_defense_finder_genes.tsv {output.genes} 2>/dev/null \
            || touch {output.genes}
        """


# ── 4a. PADLOC database setup (runs once) ────────────────────────────────────
rule padloc_db_update:
    output:
        flag = "data/raw/databases/padloc_db_ready.flag",
    conda: "envs/padloc.yaml"
    shell:
        """
        padloc --db-update
        touch {output.flag}
        """

# ── 4b. PADLOC annotation ─────────────────────────────────────────────────────
rule padloc:
    input:
        fasta   = "data/raw/genomes/{sp}/{acc_fn}.fna",
        db_flag = "data/raw/databases/padloc_db_ready.flag",
    output:
        csv = "data/interim/{sp}/padloc/{acc_fn}_padloc.csv",
    params:
        outdir = "data/interim/{sp}/padloc",
    conda: "envs/padloc.yaml"
    shell:
        """
        mkdir -p {params.outdir}
        padloc --fna {input.fasta} \
               --outdir {params.outdir} \
               --cpu 2
        [ -f {output.csv} ] || touch {output.csv}
        """


# ── 5. ResFinder (ARG detection) ──────────────────────────────────────────────
# Uses existing resfinder_env — matches published Acinetobacter pipeline version.
rule resfinder:
    input:
        fasta = "data/raw/genomes/{sp}/{acc_fn}.fna",
    output:
        tab = "data/interim/{sp}/resfinder/{acc_fn}/ResFinder_results_tab.txt",
    params:
        outdir   = "data/interim/{sp}/resfinder/{acc_fn}",
        db_path  = RESFINDER_DB,
    conda:
        "/opt/homebrew/Caskroom/miniconda/base/envs/resfinder_env"
    shell:
        """
        mkdir -p {params.outdir}
        python -m resfinder \
            -ifa {input.fasta} \
            -o {params.outdir} \
            -db_res {params.db_path} \
            -s "Other" \
            --acquired \
            -l 0.6 \
            -t 0.9
        [ -f {output.tab} ] || touch {output.tab}
        """


# ── 6. ISEScan — insertion sequence detection ────────────────────────────────
# IS elements are distinct from IMEs/ICEs (caught by ICEberg tBLASTn).
# ISEScan creates output in {run_dir}/{sp}/{acc_fn}.fna.{tsv,sum} — the
# subdirectory is derived from the input file's parent directory name.
# Intermediate proteome and HMM files (~25 MB per genome) are deleted after
# the TSV and sum are extracted to keep disk usage manageable.
rule isescan:
    input:
        fasta = "data/raw/genomes/{sp}/{acc_fn}.fna",
    output:
        tsv = "data/interim/{sp}/isescan/{acc_fn}_isescan.tsv",
        sum = "data/interim/{sp}/isescan/{acc_fn}_isescan.sum",
    params:
        run_dir = "data/interim/{sp}/isescan/{acc_fn}_run",
    threads: 2
    conda: "envs/isescan.yaml"
    shell:
        """
        mkdir -p {params.run_dir}
        isescan.py \
            --seqfile {input.fasta} \
            --output {params.run_dir} \
            --nthread {threads}
        mv -f {params.run_dir}/{wildcards.sp}/{wildcards.acc_fn}.fna.tsv {output.tsv} 2>/dev/null \
            || touch {output.tsv}
        mv -f {params.run_dir}/{wildcards.sp}/{wildcards.acc_fn}.fna.sum {output.sum} 2>/dev/null \
            || touch {output.sum}
        rm -rf {params.run_dir}
        """


# ── 7. ICEberg IME tBLASTn ────────────────────────────────────────────────────
# Searches for integrative mobile elements using protein sequences from ICEberg.
# Same approach as published Acinetobacter pipeline.
rule iceberg_tblastn:
    input:
        fasta  = "data/raw/genomes/{sp}/{acc_fn}.fna",
        db     = ICEBERG_DB,
    output:
        tsv = "data/interim/{sp}/iceberg/{acc_fn}_iceberg.tsv",
    params:
        evalue  = 1e-5,
        # pident >= 40 filter applied in Phase 3 post-processing (tblastn 2.17.0
        # does not support -perc_identity; same fix as bacmet_tblastn)
    conda: "envs/blast.yaml"
    shell:
        """
        mkdir -p data/interim/{wildcards.sp}/iceberg
        tblastn \
            -query {input.db} \
            -subject {input.fasta} \
            -evalue {params.evalue} \
            -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore" \
            -out {output.tsv} 2>/dev/null || true
        [ -f {output.tsv} ] || touch {output.tsv}
        """


# ── 9. BacMet HMRG tBLASTn ───────────────────────────────────────────────────
rule bacmet_tblastn:
    input:
        fasta = "data/raw/genomes/{sp}/{acc_fn}.fna",
        db    = BACMET_DB,
    output:
        tsv = "data/interim/{sp}/bacmet/{acc_fn}_bacmet.tsv",
    params:
        evalue  = 1e-5,
    conda: "envs/blast.yaml"
    shell:
        """
        mkdir -p data/interim/{wildcards.sp}/bacmet
        tblastn \
            -query {input.db} \
            -subject {input.fasta} \
            -evalue {params.evalue} \
            -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore" \
            -out {output.tsv}
        """


# ── 10. MLST typing (per species, all genomes) ────────────────────────────────
rule mlst:
    input:
        fastas = lambda wc: expand(
            "data/raw/genomes/{sp}/{acc_fn}.fna",
            sp=wc.sp,
            acc_fn=[acc_to_fname(a) for a in ACCESSIONS[wc.sp]],
        ),
    output:
        tsv = "data/interim/{sp}/mlst/mlst_results.tsv",
    params:
        genome_dir = "data/raw/genomes/{sp}",
    conda: "envs/blast.yaml"
    shell:
        """
        mkdir -p data/interim/{wildcards.sp}/mlst
        mlst {params.genome_dir}/*.fna > {output.tsv}
        """


# ── 11. Collect NCBI metadata per species ─────────────────────────────────────
# Assembles the per-genome metadata table from pre-fetched JSON files.
# The JSON was written by build_accession_lists.py to data/interim/.
rule collect_metadata:
    input:
        json = "data/interim/{sp}_accession_metadata.json",
    output:
        tsv = "data/interim/{sp}/metadata.tsv",
    run:
        import json, csv
        with open(input.json) as f:
            records = json.load(f)
        fields = ["accession", "organism", "country", "year_bin",
                  "release_date", "biosample", "complex_member"]
        with open(output.tsv, "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=fields, delimiter="\t",
                               extrasaction="ignore")
            w.writeheader()
            w.writerows(records)


# ── 12a. AMRFinderPlus database (runs once per conda env lifetime) ────────────
# amrfinder -u only writes to the default path inside its own conda env;
# --database is not permitted with -u.  The flag file serves as Snakemake's
# dependency marker so this step runs once and is skipped on re-runs.
rule amrfinderplus_db:
    output:
        flag = AMRFINDER_FLAG,
    conda: "envs/amrfinderplus.yaml"
    shell:
        """
        amrfinder -u && touch {output.flag}
        """


# ── 12b. AMRFinderPlus per genome ─────────────────────────────────────────────
# Uses the .prt protein predictions already produced by the DefenseFinder rule
# (pyrodigal-translated, Prodigal-format headers) — no re-annotation needed.
# --plus activates the METAL/BIOCIDE/STRESS gene families.
# --organism applies species-specific HMM profiles; critical for correct
# gram-positive metal resistance detection (SA CopAZ, EF cadmium, etc.).
# Filter for metal resistance genes in Phase 3: Subtype == "METAL".
rule amrfinderplus:
    input:
        proteins = "data/interim/{sp}/defensefinder/{acc_fn}/{acc_fn}.prt",
        db_flag  = AMRFINDER_FLAG,
    output:
        tsv = "data/interim/{sp}/amrfinderplus/{acc_fn}_amrfinder.tsv",
    params:
        organism = lambda wc: AMRFINDER_ORGANISM[wc.sp],
    conda: "envs/amrfinderplus.yaml"
    shell:
        """
        mkdir -p data/interim/{wildcards.sp}/amrfinderplus
        AMR_HEADER='Protein id\tElement symbol\tElement name\tScope\tType\tSubtype\tClass\tSubclass\tMethod\tTarget length\tReference sequence length\t%% Coverage of reference\t%% Identity to reference\tAlignment length\tClosest reference accession\tClosest reference name\tHMM accession\tHMM description'
        if amrfinder \
                --protein {input.proteins} \
                --plus \
                --organism {params.organism} \
                --output {output.tsv} 2>/dev/null; then
            : # organism-specific run succeeded
        elif amrfinder \
                --protein {input.proteins} \
                --plus \
                --output {output.tsv} 2>/dev/null; then
            : # fallback: pan-bacterial run succeeded (no organism-specific profiles)
        else
            # Both runs crashed (known amr_report v4.2.7 HMM domain parsing bug).
            # Write header-only TSV; genome coded as zero metal resistance in Phase 3.
            printf "${{AMR_HEADER}}\n" > {output.tsv}
        fi
        """
